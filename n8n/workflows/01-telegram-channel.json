    {
      "id": "80b54424-1a95-40cf-9862-e04904bd96d7",
      "name": "Attachment → base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "data",
        "destinationKey": "data",
        "options": {}
      }
    },
    {
      "id": "1c675980-550c-4a28-b287-5181058cfa77",
      "name": "Build brain request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalise a Telegram update into the brain's inbound format.\nconst m = $('Telegram Trigger').item.json.message ?? {};\nconst bin = $('Telegram Trigger').item.binary?.data;\nconst body = {\n  channel: 'telegram',\n  externalId: String(m.chat?.id ?? ''),\n  displayName: [m.from?.first_name, m.from?.last_name].filter(Boolean).join(' ') || m.from?.username || null,\n  messageId: String(m.message_id ?? ''),\n  text: m.text ?? m.caption ?? null,\n};\nif ($json.data && bin) {\n  const media = { data: $json.data, mime: bin.mimeType || 'application/octet-stream', name: bin.fileName || 'file' };\n  if (m.voice || m.audio) body.audio = { ...media, mime: m.voice ? 'audio/ogg' : (m.audio?.mime_type || media.mime) };\n  else if (m.photo) body.image = { ...media, mime: media.mime.startsWith('image/') ? media.mime : 'image/jpeg' };\n  else if (m.document) body.document = { ...media, mime: m.document.mime_type || media.mime, name: m.document.file_name || media.name };\n}\nreturn { json: { chatId: body.externalId, body } };"
      }
    },
    {
      "id": "9073bd67-14b7-426d-8901-65f63f8a8ea8",
      "name": "Ask SwarmAI brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SWARM_BRAIN_URL }}/api/channels/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Swarm-Key",
              "value": "={{ $env.SWARM_N8N_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "8faaee9b-b4f6-4e3b-a896-f40934528dac",
