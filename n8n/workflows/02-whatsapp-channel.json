      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { voice: $('Ask SwarmAI brain').item.json.voice } };"
      }
    },
    {
      "id": "86b03686-b177-4973-a51b-a4460dbd2e4f",
      "name": "Voice reply → MP3",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [
