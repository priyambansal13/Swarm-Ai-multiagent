# Docker Compose (PostgreSQL + n8n). Copy to ./.env
POSTGRES_USER=swarm
POSTGRES_PASSWORD=swarm
POSTGRES_PORT=5434
N8N_PORT=5678
N8N_VERSION=2.43.7
# Long random string; back it up — it encrypts every credential stored in n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
TIMEZONE=Asia/Kolkata
# Public HTTPS base URL of n8n (Cloudflare Tunnel / ngrok / domain). Telegram & WhatsApp webhooks need it.
N8N_PUBLIC_URL=http://localhost:5678/
# How n8n reaches the brain service, and the shared secret both sides use
SWARM_BRAIN_URL=http://host.docker.internal:4200
SWARM_N8N_TOKEN=dev-n8n-shared-secret
# WhatsApp Cloud API phone number id (used by the WhatsApp workflows)
WHATSAPP_PHONE_NUMBER_ID=

# --- Channels (used by n8n/setup.sh to create n8n credentials) ---
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta app id/secret (for the WhatsApp Trigger webhook subscription)
META_APP_ID=
META_APP_SECRET=
# Bearer token protecting the n8n MCP server (brain uses the same value as N8N_MCP_TOKEN)
N8N_MCP_TOKEN=dev-mcp-token
# Optional: your Telegram chat id for workflow error alerts
SWARM_ADMIN_TELEGRAM_CHAT_ID=
