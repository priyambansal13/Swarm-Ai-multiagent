{
  "id": "SwarmScheduler01",
  "name": "SwarmAI – Scheduler (reminders, briefs, alerts)",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "f2d53283-0e2a-4b21-b51c-9e71aa9665e8",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "fd5fd536-46fd-457c-bad9-97b311f12476",
      "name": "Tick brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SWARM_BRAIN_URL }}/api/automations/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Swarm-Key",
              "value": "={{ $env.SWARM_N8N_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "29983d2d-3cb2-4a45-819e-fd2f5e3b6b85",
      "name": "One item per message",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "deliveries",
        "options": {}
      }
    },
    {
      "id": "39c0c9ff-a18b-4243-a880-788a3cbd16fb",
      "name": "Telegram?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f54ae8ed-6264-4aa4-8102-a1f5267c0da2",
              "leftValue": "={{ $json.channel }}",
              "rightValue": "telegram",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6b1aeae5-4d21-48b7-985a-1975a544d940",
      "name": "Send on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "disable_web_page_preview": true
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "SwarmCredTelegram",
          "name": "SwarmAI Telegram bot"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "4b3c764c-9fd2-4e5c-8531-26578921312f",
      "name": "Send on WhatsApp",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $json.chatId }}",
        "messageType": "text",
        "textBody": "={{ $json.text }}",
        "additionalFields": {}
      },
      "credentials": {
        "whatsAppApi": {
          "id": "SwarmCredWhatsApp",
          "name": "SwarmAI WhatsApp Cloud API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "9a0fb87b-c782-4b39-9277-c518d1fb67b6",
      "name": "Ack delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SWARM_BRAIN_URL }}/api/automations/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Swarm-Key",
              "value": "={{ $env.SWARM_N8N_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sent: [$('One item per message').item.json.id] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "1a4ed455-7543-413d-b905-ba68e640eee2",
      "name": "Ack failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SWARM_BRAIN_URL }}/api/automations/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Swarm-Key",
              "value": "={{ $env.SWARM_N8N_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ failed: [{ id: $('One item per message').item.json.id, error: String($json.error?.message ?? $json.error ?? 'send failed').slice(0, 300) }] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Tick brain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tick brain": {
      "main": [
        [
          {
            "node": "One item per message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per message": {
      "main": [
        [
          {
            "node": "Telegram?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram?": {
      "main": [
        [
          {
            "node": "Send on Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send on WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send on Telegram": {
      "main": [
        [
          {
            "node": "Ack delivered",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ack failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send on WhatsApp": {
      "main": [
        [
          {
            "node": "Ack delivered",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ack failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "errorWorkflow": "SwarmErrors00001"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}