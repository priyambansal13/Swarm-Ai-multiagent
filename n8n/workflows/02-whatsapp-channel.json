{
  "id": "SwarmWhatsApp001",
  "name": "SwarmAI – WhatsApp channel",
  "active": false,
  "isArchived": false,
  "nodes": [
    {
      "id": "5f9b10ea-14b6-4205-8a38-1ee4e8040c5e",
      "name": "WhatsApp Trigger",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {
        "updates": [
          "messages"
        ],
        "options": {}
      },
      "credentials": {
        "whatsAppTriggerApi": {
          "id": "SwarmCredWaTrigger",
          "name": "SwarmAI WhatsApp webhook (Meta app)"
        }
      },
      "webhookId": "16c8a4a4-d19d-4be4-8bea-43459e2f4317"
    },
    {
      "id": "884319b3-9696-48e5-9a62-cafd1fc81d0d",
      "name": "Parse messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per incoming user message (status updates are ignored).\nconst out = [];\nfor (const item of $input.all()) {\n  const v = item.json;\n  const val = v.entry?.[0]?.changes?.[0]?.value ?? v;\n  const name = val.contacts?.[0]?.profile?.name ?? null;\n  for (const msg of val.messages ?? []) {\n    const media = msg.audio ?? msg.voice ?? msg.image ?? msg.document ?? null;\n    const kind = msg.audio || msg.voice ? 'audio' : msg.image ? 'image' : msg.document ? 'document' : null;\n    out.push({ json: {\n      phone: msg.from,\n      body: { channel: 'whatsapp', externalId: msg.from, to: val.metadata?.phone_number_id ?? null, displayName: name, messageId: msg.id,\n              text: msg.text?.body ?? msg.image?.caption ?? msg.document?.caption ?? msg.button?.text ?? msg.interactive?.button_reply?.title ?? null },\n      mediaId: media?.id ?? '', mediaKind: kind, mediaMime: media?.mime_type ?? null, mediaName: msg.document?.filename ?? kind,\n    } });\n  }\n}\nreturn out;"
      }
    },
    {
      "id": "e5744742-40ac-4b7d-a5cd-897280e5cdf3",
      "name": "Has media?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c8e1dddc-d4c0-4b55-8600-c8ff6863bccc",
              "leftValue": "={{ $json.mediaId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "453cdd76-a5b8-4b3c-820f-240881ce8778",
      "name": "Get media URL",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": "={{ $json.mediaId }}"
      },
      "credentials": {
        "whatsAppApi": {
          "id": "SwarmCredWhatsApp",
          "name": "SwarmAI WhatsApp Cloud API"
        }
      }
    },
    {
      "id": "8d25b9a0-82f2-4c24-805d-b4db08f431ce",
      "name": "Download media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "whatsAppApi",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 60000
        }
      },
      "credentials": {
        "whatsAppApi": {
          "id": "SwarmCredWhatsApp",
          "name": "SwarmAI WhatsApp Cloud API"
        }
      }
    },
    {
      "id": "4f3b9530-700f-49ac-b290-7e9e3ea3ee90",
      "name": "Media → base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "operation": "binaryToPropery",
        "binaryPropertyName": "data",
        "destinationKey": "data",
        "options": {}
      }
    },
    {
      "id": "522f44d3-8d94-4724-9d5a-4e61a13d58fe",
      "name": "Build brain request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('Parse messages').item.json;\nconst body = { ...p.body };\nif ($json.data && p.mediaKind) body[p.mediaKind] = { data: $json.data, mime: p.mediaMime || 'application/octet-stream', name: p.mediaName || 'file' };\nreturn { json: { phone: p.phone, body } };"
      }
    },
    {
      "id": "8256e956-129c-4e47-80ec-604fea5e5ff3",
      "name": "Ask SwarmAI brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SWARM_BRAIN_URL }}/api/channels/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Swarm-Key",
              "value": "={{ $env.SWARM_N8N_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "e3bfce2d-4993-4b08-bcce-05ea0f4af124",
      "name": "Has reply?",
      "type": "n8n-nodes-base.if",
