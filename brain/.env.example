# ════════════════════════════════════════════════════════════════════
#  SwarmAI brain (NestJS + LangGraph). Copy to brain/.env
# ════════════════════════════════════════════════════════════════════

# --- Server ---
PORT=4200
PUBLIC_API_URL=http://localhost:4200
WEB_URL=http://localhost:3200
CORS_ORIGIN=http://localhost:3200
# Signs login tokens and encrypts Google refresh tokens — long random string, keep secret
APP_SECRET=change-me-to-a-long-random-string

# --- Database (docker-compose Postgres with pgvector) ---
DATABASE_URL=postgres://swarm:swarm@localhost:5434/swarm

# --- OpenAI (REQUIRED) ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Google (Gmail, Calendar, Sheets) — each user connects their own account ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Enable Gmail, Calendar, Sheets APIs.
# Authorised redirect URI: http://localhost:4200/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/api/google/callback

# --- Search: SerpAPI (web, news, shopping, flights, hotels). Blank = keyless fallbacks ---
SERPAPI_KEY=

# Who can create accounts: open (anyone; default) or invite (invite links only — the first account is always allowed)
SIGNUP_MODE=open

# --- n8n ---
# Shared secret n8n sends as X-Swarm-Key (must match SWARM_N8N_TOKEN in the root .env)
SWARM_N8N_TOKEN=dev-n8n-shared-secret
# MCP Server Trigger URL of the "SwarmAI – Channel tools (MCP)" workflow, and its bearer token
N8N_MCP_URL=
N8N_MCP_TOKEN=
# For link instructions in the web app
TELEGRAM_BOT_USERNAME=
WHATSAPP_DISPLAY_NUMBER=

# --- Yatra AI travel planner (optional; from the travel-planner project) ---
YATRA_API_URL=http://localhost:4100
YATRA_WEB_URL=http://localhost:3100

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=swarm-ai
